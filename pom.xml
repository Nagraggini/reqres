<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ownproject</groupId>
    <artifactId>reqres</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <name>reqres</name>
    <url>https://reqres.in/</url>


    <!-- ========================================================= -->
    <!-- PROPERTIES                                                -->
    <!-- ========================================================= -->

    <properties>

        <!-- Java -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>

        <!-- Allure -->
        <allure.version>2.29.1</allure.version>

        <!-- JUnit -->
        <junit.version>5.11.0</junit.version>

        <!-- REST Assured -->
        <rest.assured.version>5.5.6</rest.assured.version>

        <!-- Jackson -->
        <jackson.version>2.17.1</jackson.version>

        <!-- Log4j -->
        <log4j.version>2.26.0</log4j.version>

        <!-- dotenv -->
        <dotenv.version>3.0.0</dotenv.version>

    </properties>


    <!-- ========================================================= -->
    <!-- DEPENDENCIES                                               -->
    <!-- ========================================================= -->

    <dependencies>

        <!-- ===================================================== -->
        <!-- REST ASSURED                                           -->
        <!-- ===================================================== -->

        <!--
            REST API teszteléshez.
            Forrás:
            https://mvnrepository.com/artifact/io.rest-assured/rest-assured
        -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${rest.assured.version}</version>
            <scope>test</scope>
        </dependency>


        <!-- ===================================================== -->
        <!-- JUNIT 5                                                -->
        <!-- ===================================================== -->

        <!--
            JUnit 5 tesztelési framework.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>


        <!-- ===================================================== -->
        <!-- ALLURE                                                 -->
        <!-- ===================================================== -->

        <!--
            Allure és JUnit 5 integráció.
        -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-junit5</artifactId>
            <version>${allure.version}</version>
            <scope>test</scope>
        </dependency>


        <!-- ===================================================== -->
        <!-- LOG4J                                                  -->
        <!-- ===================================================== -->

        <!--
            Log4j logging.
        -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>${log4j.version}</version>
        </dependency>


        <!-- ===================================================== -->
        <!-- JACKSON                                                -->
        <!-- ===================================================== -->

        <!--
            JSON feldolgozás és POJO objektumok használata.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>


        <!-- ===================================================== -->
        <!-- DOTENV                                                 -->
        <!-- ===================================================== -->

        <!--
            Környezeti változók / .env fájl kezeléséhez.
        -->
        <dependency>
            <groupId>io.github.cdimascio</groupId>
            <artifactId>dotenv-java</artifactId>
            <version>${dotenv.version}</version>
        </dependency>

    </dependencies>


    <!-- ========================================================= -->
    <!-- BUILD                                                      -->
    <!-- ========================================================= -->

    <build>

        <plugins>

            <!-- ================================================= -->
            <!-- MAVEN COMPILER                                     -->
            <!-- ================================================= -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.12.1</version>

                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>


            <!-- ================================================= -->
            <!-- MAVEN SUREFIRE                                     -->
            <!-- ================================================= -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.3.0</version>

                <configuration>

                    <!--
                        Allure eredményfájlok helye:
                        target/allure-results/
                    -->
                    <systemPropertyVariables>

                        <allure.results.directory>
                            ${project.build.directory}/allure-results
                        </allure.results.directory>

                    </systemPropertyVariables>

                </configuration>

            </plugin>

        </plugins>

    </build>

</project>